        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "express-validator": "^7.2.1",
        "googleapis": "^126.0.1",
        "helmet": "^7.0.0",
        "joi": "^17.9.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.5.0",
        "uuid": "^9.0.0",
        "winston": "^3.17.0"
